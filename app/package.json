  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "prisma": "5.19.1",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
