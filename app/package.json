{
  "name": "proto-stack",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "brand-lint": "node scripts/brand-lint.mjs",
    "security-lint": "node scripts/security-lint.mjs",
    "contrast": "node scripts/brand-tools.mjs contrast",
    "brand:mirror": "node scripts/brand-tools.mjs mirror",
    "check": "npm run brand-lint && npm run security-lint && npm run contrast",
