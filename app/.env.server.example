# =============================================================================
# proto-stack server environment
#
# Copy this file to `.env.server` (git-ignored) and fill in what you need.
# A fresh prototype boots with ZERO changes here — every external provider is
# optional in dev. Each var links to its setup guide in docs/providers.md.
#
# After editing this file, restart `wasp start` — main.wasp.ts reads it at
# compile time to decide which auth methods and email provider to enable.
# =============================================================================

# --- Database --------------------------------------------------------------
# Not needed locally: `wasp start db` runs Postgres in Docker and sets this.
# In production, `wasp deploy railway` provisions Postgres and sets it for you.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth: email verification (dev) ----------------------------------------
# When true, dev signups are auto-verified — no console link click needed.
# The /ship skill removes this for production. Keep it on locally.
SKIP_EMAIL_VERIFICATION_IN_DEV=true

# --- Admin -----------------------------------------------------------------
# Comma-separated emails that get isAdmin=true at signup. No roles table.
ADMIN_EMAILS=you@example.com

# --- Email provider --------------------------------------------------------
# Default is "Dummy": verification/reset emails are printed to the wasp server
# console — perfect for dev. `wasp build` refuses Dummy, so switch to a real
# provider before shipping. Guide: docs/providers.md#resend (recommended).
# EMAIL_PROVIDER=Resend
# EMAIL_FROM_NAME=ProtoStack
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# RESEND_API_KEY=re_...          # https://resend.com/api-keys

# --- Google OAuth (optional) -----------------------------------------------
# Set BOTH to enable the "Sign in with Google" button (auto-detected at
# compile time). Guide + exact redirect URI: docs/providers.md#google-oauth
# Dev redirect URI: http://localhost:3001/auth/google/callback
# GOOGLE_CLIENT_ID=...           # https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_SECRET=...
