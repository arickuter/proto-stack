{
  "flat": true,
  "gradients": false,
  "shadows": false,
  "fonts": {
    "display": "Space Grotesk",
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "hexAllowlist": ["src/brand/palette.ts"],
